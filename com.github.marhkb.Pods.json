{
  "id": "com.github.marhkb.Pods",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "pods",
  "finish-args": [
    "--socket=fallback-x11",
    "--socket=wayland",
    "--share=network",
    "--share=ipc",
    "--device=dri",
    "--env=G_MESSAGES_DEBUG=none",
    "--env=RUST_BACKTRACE=1",
    "--filesystem=/run/systemd/journal",
    "--filesystem=xdg-run/podman:ro",
    "--filesystem=/run/docker.sock"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin"
  },
  "cleanup": [
    "/include",
    "/lib/cmake",
    "/lib/pkgconfig",
    "/share/cmake",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "fast_float",
      "buildsystem": "cmake-ninja",
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/fastfloat/fast_float.git",
          "tag": "v8.3.1",
          "commit": "f3f02c8ad0afd8181166dabce6a9e69f8aec24de",
          "x-checker-data": {
            "type": "anitya",
            "project-id": 214353,
            "tag-template": "v$version"
          }
        }
      ]
    },
    {
      "name": "simdutf",
      "buildsystem": "cmake-ninja",
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/simdutf/simdutf.git",
          "tag": "v9.2.1",
          "commit": "dc3f7a8fa291f2ce793c7b0ddd458f4e67542f14",
          "x-checker-data": {
            "type": "anitya",
            "project-id": 378662,
            "tag-template": "v$version"
          }
        }
      ]
    },
    {
      "name": "vte",
      "buildsystem": "meson",
      "config-opts": [
        "-Dapp=false",
        "-Ddocs=false",
        "-Dgir=false",
        "-Dglade=false",
        "-Dgtk3=false",
        "-Dgtk4=true",
        "-D_systemd=false",
        "-Dvapi=false",
        "-Dbuildtype=release"
      ],
      "cleanup": [
        "/bin/vte-*"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/GNOME/vte.git",
          "tag": "0.84.0",
          "commit": "5da1ed34b210f2b000ef954c147f9a1391da363b"
        }
      ]
    },
    {
      "name": "pods",
      "buildsystem": "meson",
      "config-opts": [
        "-Dbuildtype=release"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/marhkb/pods/releases/download/v3.2.0/pods-v3.2.0.tar.xz",
          "sha256": "16b2f4e7c7145570dcdf4ea357638fcd32f0e90c8ff58c3263883c2e8d83c481",
          "strip-components": 0
        }
      ]
    }
  ]
}
