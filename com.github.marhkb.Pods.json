{
  "id": "com.github.marhkb.Pods",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "pods",
  "finish-args": [
    "--socket=fallback-x11",
    "--socket=wayland",
    "--share=network",
    "--share=ipc",
    "--device=dri",
    "--env=G_MESSAGES_DEBUG=none",
    "--env=RUST_BACKTRACE=1",
    "--filesystem=/run/systemd/journal",
    "--filesystem=xdg-run/podman:ro",
    "--filesystem=/run/docker.sock"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin"
  },
  "cleanup": [
    "/include",
    "/lib/cmake",
    "/lib/pkgconfig",
    "/share/cmake",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "fast_float",
      "buildsystem": "cmake-ninja",
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/fastfloat/fast_float.git",
          "tag": "v8.3.3",
          "commit": "dbeabeeb3e6791cb96994c2a7a084c36e62ccfb2",
          "x-checker-data": {
            "type": "anitya",
            "project-id": 214353,
            "tag-template": "v$version"
          }
        }
      ]
    },
    {
      "name": "simdutf",
      "buildsystem": "cmake-ninja",
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/simdutf/simdutf.git",
          "tag": "v9.3.3",
          "commit": "59589cd3df6823cbfdbd253cde3377e7c3e1fe9b",
          "x-checker-data": {
            "type": "anitya",
            "project-id": 378662,
            "tag-template": "v$version"
          }
        }
      ]
    },
    {
      "name": "vte",
      "buildsystem": "meson",
      "config-opts": [
        "-Dapp=false",
        "-Ddocs=false",
        "-Dgir=false",
        "-Dglade=false",
        "-Dgtk3=false",
        "-Dgtk4=true",
        "-D_systemd=false",
        "-Dvapi=false",
        "-Dbuildtype=release"
      ],
      "cleanup": [
        "/bin/vte-*"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/GNOME/vte.git",
          "tag": "0.84.0",
          "commit": "5da1ed34b210f2b000ef954c147f9a1391da363b"
        }
      ]
    },
    {
      "name": "pods",
      "buildsystem": "meson",
      "config-opts": [
        "-Dbuildtype=release"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/marhkb/pods/releases/download/v3.3.0/pods-v3.3.0.tar.xz",
          "sha256": "c3f1b38343902d7ae92653db7665919414085bb11584f961caa6594288fa4314",
          "strip-components": 0
        }
      ]
    }
  ]
}
